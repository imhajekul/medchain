# ==============================================================================
# MedVault Client Production Environment Configuration
# ==============================================================================

# API Base URL (Leave empty or set to /api if deploying behind reverse proxy)
# In local dev: http://localhost:3001/api
# In production: https://api.medvault.app/api or /api
VITE_API_URL=/api

# EVM Chain ID (80002 for Polygon Amoy, 84532 for Base Sepolia, 137 for Polygon Mainnet)
VITE_CHAIN_ID=80002
VITE_CHAIN_NAME="Polygon Amoy"
VITE_RPC_URL="https://rpc-amoy.polygon.technology/"

# MedVaultAccess Smart Contract Address
VITE_CONTRACT_ADDRESS=0x38b8AcE4624DEb11568A57866e4a28Ece055D0f6

# Firebase Authentication (Optional for custom production Firebase project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
