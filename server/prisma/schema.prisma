// =============================================================================
// MedVault Database Schema (Prisma ORM for MongoDB)
// Optimized for Fast-Read Off-Chain Queries & On-Chain Event Synchronization
// =============================================================================

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  PATIENT
  DOCTOR
}

enum GrantStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AuditEventType {
  ISSUED
  ACCESSED
  EXPIRED
  REVOKED
}

// -----------------------------------------------------------------------------
// MODELS (MongoDB Document Collections)
// -----------------------------------------------------------------------------

/// User model anchored by Ethereum wallet address (EIP-4361 standard) & Firebase/Google Auth
model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  walletAddress String   @unique
  email         String?  @unique
  passwordHash  String?
  salt          String?
  name          String?
  role          Role     @default(PATIENT)
  nonce         String?  // Ephemeral SIWE challenge nonce
  createdAt     DateTime @default(now())

  // Relations
  recordsOwned   Record[]     @relation("RecordOwner")
  grantsReceived Grant[]      @relation("GranteeUser")
  auditActions   AuditEvent[] @relation("ActorUser")

  @@index([role])
}

/// Medical record metadata pointer to client-side AES-256 encrypted blobs
/// INVARIANT: The server NEVER stores unencrypted medical data or master keys.
model Record {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  recordIdHex          String   @unique // On-chain bytes32 ID (0x...)
  ownerWallet          String
  ownerId              String   @db.ObjectId
  owner                User     @relation("RecordOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  storageCID           String   // IPFS CID of AES-256 ciphertext
  label                String   // Plaintext label / description
  encryptedKeyMaterial String   // DEK encrypted for patient's public key (base64)
  contentHash          String   // SHA-256 hash of ciphertext for tamper verification
  fileSizeBytes        Int      @default(0)
  mimeType             String   @default("application/octet-stream")
  createdAt            DateTime @default(now())

  // Relations
  grants      Grant[]
  auditEvents AuditEvent[]

  @@index([ownerWallet])
  @@index([storageCID])
}

/// Time-boxed access grants from patient to healthcare provider
model Grant {
  id                   String      @id @default(auto()) @map("_id") @db.ObjectId
  grantIdHex          String      @unique // On-chain bytes32 ID
  recordId             String      @db.ObjectId
  record               Record      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  
  granteeWallet        String
  granteeId            String      @db.ObjectId
  grantee              User        @relation("GranteeUser", fields: [granteeId], references: [id], onDelete: Cascade)
  
  expiresAt            DateTime
  status               GrantStatus @default(ACTIVE)
  encryptedKeyMaterial String      // DEK asymmetrically wrapped for doctor's public key
  txHash               String?     // On-chain grant transaction hash
  createdAt            DateTime    @default(now())

  // Relations
  auditEvents AuditEvent[]

  @@index([granteeWallet, status, expiresAt])
  @@index([recordId])
}

/// Read-optimized append-only audit trail replicating on-chain events
model AuditEvent {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  grantId     String?        @db.ObjectId
  grant       Grant?         @relation(fields: [grantId], references: [id], onDelete: SetNull)
  
  recordId    String         @db.ObjectId
  record      Record         @relation(fields: [recordId], references: [id], onDelete: Cascade)
  
  actorWallet String
  actorId     String         @db.ObjectId
  actor       User           @relation("ActorUser", fields: [actorId], references: [id], onDelete: Cascade)
  
  eventType   AuditEventType
  context     String?
  txHash      String?        // On-chain transaction hash (null if pending)
  timestamp   DateTime       @default(now())

  @@index([recordId])
  @@index([actorWallet])
}

/// Tracks blockchain indexer synchronization block height
model IndexerState {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  network          String   @unique // e.g., 'polygon-amoy', 'base-sepolia'
  lastIndexedBlock Int
  updatedAt        DateTime @default(now()) @updatedAt
}
