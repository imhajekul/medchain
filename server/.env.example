# ==============================================================================
# MedVault Production Environment Configuration
# Principle: Zero Plaintext PHI Exposure Enforced
# ==============================================================================

# Node Runtime
PORT=3001
NODE_ENV=production

# Database (PostgreSQL with Prisma)
# In production Docker: postgresql://medvault_user:medvault_pass@postgres:5432/medvault?schema=public
DATABASE_URL=postgresql://medvault:medvault_secure_password_2026@localhost:5432/medvault?schema=public
DATABASE_SSL=false

# Session Security (Minimum 32 random characters)
JWT_SECRET=replace_this_with_a_cryptographically_secure_random_64_char_secret_key

# Blockchain Network (Polygon Amoy / Base Sepolia / Mainnet)
RPC_URL=https://rpc-amoy.polygon.technology/
CONTRACT_ADDRESS=0x38b8AcE4624DEb11568A57866e4a28Ece055D0f6
RELAYER_PRIVATE_KEY=your_relayer_private_key_for_signing_access_events_on_chain

# Decentralized Storage (Pinata IPFS Gateway & Pinning Service)
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=

# Security & Access Control
# Comma-separated list of allowed frontend origins (or * for development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://medvault.app
RATE_LIMIT_MAX=1000
