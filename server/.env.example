# ==============================================================================
# MedVault Production Environment Configuration
# Principle: Zero Plaintext PHI Exposure Enforced
# ==============================================================================

# Node Runtime
PORT=3001
NODE_ENV=production

# Primary Database (MongoDB Atlas Cluster / Local MongoDB)
# Example Atlas Cluster: mongodb+srv://username:password@cluster0.abcde.mongodb.net/medvault?retryWrites=true&w=majority
# Example Local / Docker: mongodb://medvault:medvault_secure_password_2026@localhost:27017/medvault?authSource=admin
MONGODB_URI=mongodb://localhost:27017/medvault
MONGODB_DB_NAME=medvault
DATABASE_URL=mongodb://localhost:27017/medvault

# Session Security (Cryptographically secure 64-char / 256-bit secret key)
JWT_SECRET=bf3566236c23ee0fb9bbd88ac08f1ab8ff585c1d0b87b135d6f93b70c16222e8

# Firebase Admin SDK (Server Token Verification)
FIREBASE_PROJECT_ID=medvault-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-medvault@medvault-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# MedVault AI Health & Security Copilot (Google Gemini API Key)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Blockchain Network (Polygon Amoy / Base Sepolia / Mainnet)
RPC_URL=https://rpc-amoy.polygon.technology/
CONTRACT_ADDRESS=0x38b8AcE4624DEb11568A57866e4a28Ece055D0f6
RELAYER_PRIVATE_KEY=your_relayer_private_key_for_signing_access_events_on_chain

# Decentralized Storage (Pinata IPFS Gateway & Pinning Service)
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=

# Security & Access Control
# Comma-separated list of allowed frontend origins (or * for development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://medvault.app
RATE_LIMIT_MAX=1000
