# ==============================================================================
# MedVault Full Stack Production Compose Environment
# ==============================================================================

# Database Settings
POSTGRES_USER=medvault
POSTGRES_PASSWORD=medvault_secure_password_2026
POSTGRES_DB=medvault
POSTGRES_PORT=5432

# Backend Authentication & Encryption
JWT_SECRET=replace_with_secure_random_64_character_hex_key
NODE_ENV=production

# Blockchain & Relayer (Polygon Amoy Testnet / Base Sepolia)
RPC_URL=https://rpc-amoy.polygon.technology/
CONTRACT_ADDRESS=0x38b8AcE4624DEb11568A57866e4a28Ece055D0f6
RELAYER_PRIVATE_KEY=

# Storage Pinning (Pinata / Filecoin / Web3.Storage)
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=

# Security & Traffic
CORS_ORIGIN=https://medvault.app,http://localhost
RATE_LIMIT_MAX=1000
